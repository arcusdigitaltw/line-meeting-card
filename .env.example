# 這個檔案可以完全不用。
# 大部分的人直接 npm start，再打開 /setup.html 用設定精靈就好（設定會存在 data/config.json）。
# 想用環境變數管理（例如放在雲端平台的設定頁）才需要它；環境變數的優先權比設定精靈高。

# ── 主要設定 ─────────────────────────────────────────────
# 對外的網址（一定要 https；本機測試用 ngrok／cloudflared 給的網址）。結尾不要加斜線。
PUBLIC_URL=https://你的網域
# LINE Developers → LINE Login channel → LIFF 分頁裡的 LIFF ID（長得像 1234567890-AbCdEfGh）
LIFF_ID=
# 後台密碼（有填的話，設定精靈就不能改密碼）。自己想一串長一點的亂碼（例如執行：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"）
ADMIN_TOKEN=

# ── 外觀（可不改）────────────────────────────────────────
BRAND_NAME=會議資訊卡
ORGANIZER_NAME=
ACCENT_COLOR=#0EA5E9
TIMEZONE=Asia/Taipei
PORT=3000

# ── 會議機器人（不填就只有資訊卡功能）──────────────────────
# https://www.recall.ai 申請。區域要跟你帳號的區域一樣：us-west-2／us-east-1／eu-central-1／ap-northeast-1
RECALL_API_KEY=
RECALL_REGION=us-west-2
BOT_NAME=

# ── AI 會後摘要（不填就只存逐字稿）─────────────────────────
# OpenAI 相容格式；用 OpenAI 就只要填 LLM_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
